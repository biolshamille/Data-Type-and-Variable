public class Main {
    public static void main(String[] args) {
        double centimeters = 275.5;

        int meters = (int) (centimeters / 100);
        double remainingCm = centimeters - (meters * 100);

        System.out.println("Centimeters: " + centimeters);
        System.out.println("Whole meters: " + meters);
        System.out.println("Remaining centimeters: " + remainingCm);

        int number = 25;

        double wideNumber = number;
        System.out.println("Implicit widening: " + wideNumber);

        double decimalNumber = 25.75;

        int narrowNumber = (int) decimalNumber;
        System.out.println("Explicit narrowing: " + narrowNumber);
    }
}
